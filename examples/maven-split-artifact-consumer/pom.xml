<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.ym0506.routecontract.examples</groupId>
  <artifactId>maven-split-artifact-consumer</artifactId>
  <version>0.2.0-fixture</version>
  <name>RouteContract Maven split-artifact consumer fixture</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <routecontract.version>0.2.0</routecontract.version>
    <maven.enforcer.version>3.6.3</maven.enforcer.version>
    <maven.compiler.version>3.14.1</maven.compiler.version>
    <exec.maven.version>3.6.3</exec.maven.version>
  </properties>

  <repositories>
    <repository>
      <id>routecontract-staged</id>
      <url>${routecontract.repositoryUrl}</url>
      <releases>
        <enabled>true</enabled>
        <updatePolicy>never</updatePolicy>
        <checksumPolicy>fail</checksumPolicy>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>io.github.ym0506.routecontract</groupId>
      <artifactId>${routecontract.adapterArtifactId}</artifactId>
      <version>${routecontract.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-jdbc</artifactId>
      <version>${shardingsphere.version}</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>org.locationtech.jts.io</groupId>
          <artifactId>jts-io-common</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven.enforcer.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.enforcer</groupId>
            <artifactId>enforcer-rules</artifactId>
            <version>${maven.enforcer.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>routecontract-exact-runtime</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <fail>true</fail>
              <rules>
                <requireProperty>
                  <property>routecontract.repositoryUrl</property>
                  <message>routecontract.repositoryUrl must identify the reviewed staged repository.</message>
                  <regex>file:.+</regex>
                </requireProperty>
                <requireProperty>
                  <property>routecontract.adapterArtifactId</property>
                  <regex>routecontract-shardingsphere-5[.]5([.]2)?</regex>
                </requireProperty>
                <requireProperty>
                  <property>shardingsphere.version</property>
                  <regex>5[.]5[.][23]</regex>
                </requireProperty>
                <dependencyConvergence>
                  <includes>
                    <include>org.apache.shardingsphere</include>
                  </includes>
                </dependencyConvergence>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.apache.shardingsphere:*:(,${shardingsphere.version})</exclude>
                    <exclude>org.apache.shardingsphere:*:(${shardingsphere.version},)</exclude>
                    <exclude>io.github.ym0506.routecontract:${routecontract.oppositeAdapterArtifactId}</exclude>
                    <exclude>io.github.ym0506.routecontract:routecontract-shardingsphere-5.5:(,0.2.0)</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.version}</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec.maven.version}</version>
        <executions>
          <execution>
            <id>verify-routecontract-runtime</id>
            <phase>verify</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>io.github.ym0506.routecontract.examples.maven.MavenSplitArtifactConsumerProbe</mainClass>
              <classpathScope>runtime</classpathScope>
              <systemProperties>
                <systemProperty>
                  <key>routecontract.expectedShardingSphereVersion</key>
                  <value>${shardingsphere.version}</value>
                </systemProperty>
                <systemProperty>
                  <key>routecontract.expectedAdapterArtifactId</key>
                  <value>${routecontract.adapterArtifactId}</value>
                </systemProperty>
                <systemProperty>
                  <key>routecontract.expectedVersion</key>
                  <value>${routecontract.version}</value>
                </systemProperty>
              </systemProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>routecontract-553</id>
      <properties>
        <routecontract.adapterArtifactId>routecontract-shardingsphere-5.5</routecontract.adapterArtifactId>
        <routecontract.oppositeAdapterArtifactId>routecontract-shardingsphere-5.5.2</routecontract.oppositeAdapterArtifactId>
        <shardingsphere.version>5.5.3</shardingsphere.version>
        <routecontract.wrongShardingSphereVersion>5.5.2</routecontract.wrongShardingSphereVersion>
      </properties>
    </profile>
    <profile>
      <id>routecontract-552</id>
      <properties>
        <routecontract.adapterArtifactId>routecontract-shardingsphere-5.5.2</routecontract.adapterArtifactId>
        <routecontract.oppositeAdapterArtifactId>routecontract-shardingsphere-5.5</routecontract.oppositeAdapterArtifactId>
        <shardingsphere.version>5.5.2</shardingsphere.version>
        <routecontract.wrongShardingSphereVersion>5.5.3</routecontract.wrongShardingSphereVersion>
      </properties>
    </profile>
    <profile>
      <id>wrong-non-anchor</id>
      <dependencies>
        <dependency>
          <groupId>org.apache.shardingsphere</groupId>
          <artifactId>shardingsphere-sharding-core</artifactId>
          <version>${routecontract.wrongShardingSphereVersion}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>dual-adapter</id>
      <dependencies>
        <dependency>
          <groupId>io.github.ym0506.routecontract</groupId>
          <artifactId>${routecontract.oppositeAdapterArtifactId}</artifactId>
          <version>${routecontract.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
