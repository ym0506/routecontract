<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.ym0506.routecontract.examples</groupId>
  <artifactId>dual-resolver-boundary-consumer</artifactId>
  <version>0.2.0-fixture</version>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <routecontract.selectedRuntime>@@RUNTIME@@</routecontract.selectedRuntime>
    <routecontract.selectedAdapter>@@SELECTED_ADAPTER@@</routecontract.selectedAdapter>
    <routecontract.oppositeAdapter>@@OPPOSITE_ADAPTER@@</routecontract.oppositeAdapter>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.github.ym0506.routecontract</groupId>
      <artifactId>@@FIRST_ADAPTER@@</artifactId>
      <version>0.2.0</version>
    </dependency>
    <dependency>
      <groupId>io.github.ym0506.routecontract</groupId>
      <artifactId>@@SECOND_ADAPTER@@</artifactId>
      <version>0.2.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-infra-executor</artifactId>
      <version>@@RUNTIME@@</version>
    </dependency>
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-infra-spi</artifactId>
      <version>@@RUNTIME@@</version>
    </dependency>
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>@@DATABASE_ANCHOR@@</artifactId>
      <version>@@RUNTIME@@</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.enforcer</groupId>
            <artifactId>enforcer-rules</artifactId>
            <version>3.6.3</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>reject-opposite-adapter</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <fail>true</fail>
              <rules>
                <requireJavaVersion><version>[17,18)</version></requireJavaVersion>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>io.github.ym0506.routecontract:@@OPPOSITE_ADAPTER@@</exclude>
                    <exclude>org.apache.shardingsphere:*:(,@@RUNTIME@@)</exclude>
                    <exclude>org.apache.shardingsphere:*:(@@RUNTIME@@,)</exclude>
                    <exclude>io.github.ym0506.routecontract:routecontract-shardingsphere-5.5:(,0.2.0)</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
      </plugin>
    </plugins>
  </build>
</project>
